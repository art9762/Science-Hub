# Copy to .env. This file is loaded only by the local Python server.
SCIENCE_HUB_API_BASE_URL=https://ru.cheapvibecode.ru/v1
SCIENCE_HUB_API_KEY=
# Leave blank to select a model from Settings after loading the provider catalog.
SCIENCE_HUB_MODEL=
# Storage is local; relative paths are resolved from the project directory.
SCIENCE_HUB_DATA_DIR=./data
SCIENCE_HUB_PORT=8765
